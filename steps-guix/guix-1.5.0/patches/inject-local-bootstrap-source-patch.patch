+     (\"powerpc64le-linux\" (string-append system \"/20210106/\" program))
+     (\"i586-gnu\" (string-append system \"/20200326/\" program))
+     (\"x86_64-gnu\" (string-append system \"/20241122/\" program))
+@@ -357,8 +354,9 @@
